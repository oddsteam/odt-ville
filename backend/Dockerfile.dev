# syntax=docker/dockerfile:1
# DEVELOPMENT image only. Production uses ./Dockerfile (Kamal/Thruster).
# Kept deliberately simple: gems are installed at runtime into a named volume
# (see compose.yaml) so native extensions match this Linux container, not the
# macOS host.
ARG RUBY_VERSION=3.4.2
FROM docker.io/library/ruby:$RUBY_VERSION-slim

# Build deps for native gems (pg, etc.) plus a psql client for db:prepare waits.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      libyaml-dev \
      pkg-config \
      postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Gems live in a named volume mounted here (see compose.yaml).
ENV BUNDLE_PATH=/usr/local/bundle

WORKDIR /app

EXPOSE 3190

# The actual command (bundle install + db:prepare + server) is supplied by
# compose.yaml so it can be tweaked without rebuilding the image.
CMD ["bash", "-c", "bundle install && bin/rails db:prepare && bin/rails server -b 0.0.0.0 -p 3190"]

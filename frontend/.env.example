# ODT Village frontend env. Copy to `.env` to override the built-in defaults.
# The defaults below already match the local docker-compose Keycloak, so for the
# POC you usually don't need a .env file at all.

# --- Keycloak (POC: local docker-compose) ---
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=odt
VITE_KEYCLOAK_CLIENT_ID=odt-frontend

# --- Swap to ODT's real company Keycloak: just change the three values above ---
# VITE_KEYCLOAK_URL=https://keycloak.odt.example
# VITE_KEYCLOAK_REALM=odt-corp
# VITE_KEYCLOAK_CLIENT_ID=odt-village

# Set to "true" to disable login entirely and run the original single-player
# mode (no Keycloak needed; backend falls back to the seeded user).
# VITE_AUTH_DISABLED=true

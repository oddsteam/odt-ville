{
  "name": "odt-ville-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "arch:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "graph": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src/\" --output-type dot --output-to codebase-map.dot",
    "graph:folders": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src/\" --output-type ddot --output-to codebase-map.folders.dot",
    "build": "vite build",
    "preview": "vite preview",
    "map:build": "node ../scripts/tmx-to-tiledjson.mjs public/maps/downtown.tmx public/maps/downtown.json",
    "building:prep": "node scripts/prep-building.mjs",
    "map:palette": "node scripts/curate-palette.mjs"
  },
  "dependencies": {
    "@rails/actioncable": "^8.1.300",
    "effect": "^3.21.4",
    "keycloak-js": "^26.2.4",
    "phaser": "^4.1.0",
    "posthog-js": "^1.396.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/rails__actioncable": "^8.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dependency-cruiser": "^18.0.0",
    "sharp": "^0.35.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.9"
  }
}

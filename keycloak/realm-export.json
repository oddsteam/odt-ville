{
  "realm": "odtville",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "odt-ville-web",
      "name": "ODT Ville web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "odt-ville-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "odt-ville-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "alice",
      "email": "alice@odt.example",
      "firstName": "Alice",
      "lastName": "Rivera",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "dev", "temporary": false }
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "bob",
      "email": "bob@odt.example",
      "firstName": "Bob",
      "lastName": "Chen",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "dev", "temporary": false }
      ]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "carol",
      "email": "carol@odt.example",
      "firstName": "Carol",
      "lastName": "Diaz",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "dev", "temporary": false }
      ]
    }
  ]
}

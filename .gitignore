# OS
.DS_Store

# Local secrets (posture-login creds etc.) — referenced by compose.override.yaml
.env

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/

# oh-my-claudecode local state
.omc/

# e2e verification screenshots (regenerated by .e2e/*.mjs)
.e2e/*.png

# Tiled per-user editor session state
*.tiled-session

# Local agent tooling
.codex/
.claude/

# Generated tile palette (regenerated by frontend/scripts/curate-palette.mjs)
frontend/public/maps/palette/

# Local DB backups (regenerated by scripts/migrate-content-to-homeserver.sh)
backups/
